{
  "namespace": "x_org.owasp#aivss",
  "key": "DT_DSEN",
  "version": "0.1.0",
  "name": "Data Sensitivity",
  "definition": "A decision table for assessing the sensitivity of data used in AI systems.",
  "schemaVersion": "2.0.0",
  "decision_points": {
    "x_org.owasp#aivss:DS:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "DS",
      "version": "0.1.0",
      "name": "Data Sensitivity",
      "definition": "A decision point for assessing the sensitivity of AI model data against adversarial attacks.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "N",
          "name": "None",
          "definition": "No known vulnerability or a formally proven resistance to the specific threat."
        },
        {
          "key": "L",
          "name": "Low",
          "definition": "Low vulnerability with strong mitigation in place, but some minor weaknesses may still exist."
        },
        {
          "key": "M",
          "name": "Medium",
          "definition": "Moderate vulnerability with some mitigation, but significant weaknesses remain."
        },
        {
          "key": "H",
          "name": "High",
          "definition": "Severe vulnerability with little to no mitigation in place."
        }
      ]
    },
    "x_org.owasp#aivss:DI:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "DI",
      "version": "0.1.0",
      "name": "Data Integrity",
      "definition": "Measures taken to ensure the integrity of data used in training and inference.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "F",
          "name": "Formally Verified",
          "definition": "Data integrity formally verified using techniques like blockchain or Merkle trees."
        },
        {
          "key": "S",
          "name": "Strong Checks",
          "definition": "Strong integrity checks and tamper detection mechanisms in place."
        },
        {
          "key": "B",
          "name": "Basic Checks",
          "definition": "Basic integrity checks used, but no tamper-proof mechanisms."
        },
        {
          "key": "N",
          "name": "None",
          "definition": "No data integrity checks, data can be easily modified without detection."
        }
      ]
    },
    "x_org.owasp#aivss:DP:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "DP",
      "version": "0.1.0",
      "name": "Data Provenance",
      "definition": "Degree to which the provenance of data is tracked, verified, and auditable.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "F",
          "name": "Formally Verified",
          "definition": "Data provenance formally verified and auditable, with mechanisms to ensure authenticity and trustworthiness."
        },
        {
          "key": "D",
          "name": "Detailed Lineage",
          "definition": "Detailed data lineage tracked, including all transformations and processing steps, with a clear audit trail."
        },
        {
          "key": "B",
          "name": "Basic Info",
          "definition": "Basic information about data sources available, but lineage is incomplete or unclear."
        },
        {
          "key": "N",
          "name": "None",
          "definition": "No information about data origin, collection methods, or transformations."
        }
      ]
    },
    "x_org.owasp#aivss:DCON:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "DCON",
      "version": "0.1.0",
      "name": "Data Confidentiality",
      "definition": "Measures taken to protect the confidentiality of data used in training and inference.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "A",
          "name": "Fully Anonymized",
          "definition": "Data fully anonymized using techniques like differential privacy or homomorphic encryption."
        },
        {
          "key": "E",
          "name": "Strong Encryption",
          "definition": "Strong encryption (e.g., AES-256) used for data at rest and in transit, strict access controls and key management practices in place."
        },
        {
          "key": "B",
          "name": "Basic Access Controls",
          "definition": "Sensitive data with basic access controls (e.g., passwords), but no encryption."
        },
        {
          "key": "M",
          "name": "Minimal Protection",
          "definition": "Highly sensitive data (e.g., PII, financial data) stored or processed with no or minimal protection."
        }
      ]
    }
  },
