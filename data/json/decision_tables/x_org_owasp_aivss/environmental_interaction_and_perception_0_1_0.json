{
  "namespace": "x_org.owasp#aivss",
  "key": "DT_EIP",
  "version": "0.1.0",
  "name": "Environmental Interaction and Perception",
  "definition": "A decision table for assessing the environmental interaction and perception capabilities of AI models in the context of Agentic AI Risk Score (AARS).",
  "schemaVersion": "2.0.0",
  "decision_points": {
    "x_org.owasp#aivss:TU:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "TU",
      "version": "0.1.0",
      "name": "Tool Use",
      "definition": "A decision point for assessing the Tool Use capabilities of an agentic AI System.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "N",
          "name": "None/Not Present",
          "definition": "No use of external tools, simple deterministic capabilities"
        },
        {
          "key": "P",
          "name": "Partial/Limited",
          "definition": "Limited suite of tools, limited (e.g. internal only) dynamic tool selection"
        },
        {
          "key": "F",
          "name": "Full/Unconstrained",
          "definition": "No limitations on tool selection, high risk tool capabilities"
        }
      ]
    },
    "x_org.owasp#aivss:MU:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "MU",
      "version": "0.1.0",
      "name": "Memory Use",
      "definition": "A decision point for assessing the Memory Use capabilities of an agentic AI System.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "N",
          "name": "None/Not Present",
          "definition": "Stateless memory, in-context/prompt-only memory"
        },
        {
          "key": "P",
          "name": "Partial/Limited",
          "definition": "Read only retrieval augmented generation, short-lived identity restricted sessions"
        },
        {
          "key": "F",
          "name": "Full/Unconstrained",
          "definition": "Dynamic (read and write) RAG memory, long-lived identity restricted sessions, cross-session memory/learning capabilities"
        }
      ]
    },
    "x_org.owasp#aivss:CA:0.1.0": {
      "namespace": "x_org.owasp#aivss",
      "key": "CA",
      "version": "0.1.0",
      "name": "Contextual Awareness",
      "definition": "A decision point for assessing the Contextual Awareness capabilities of an agentic AI System.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "N",
          "name": "None/Not Present",
          "definition": "No access to external context modifying data sources, no internet access, hard-coded system prompts"
        },
        {
          "key": "P",
          "name": "Partial/Limited",
          "definition": "Limited and non-volatile external context data sources, intranet or limited internet access, curated and filtered update feeds"
        },
        {
          "key": "F",
          "name": "Full/Unconstrained",
          "definition": "Dynamic and multi-agent goal negotiation, no limitations on context modifying data sources, open internet access, unrestricted update feeds"
        }
      ]
    },
    "basic:LMH:1.0.0": {
      "namespace": "basic",
      "key": "LMH",
      "version": "1.0.0",
      "name": "LowMediumHigh",
      "definition": "A Low/Medium/High decision point / outcome group.",
      "schemaVersion": "2.0.0",
      "values": [
        {
          "key": "L",
          "name": "Low",
          "definition": "Low"
        },
        {
          "key": "M",
          "name": "Medium",
          "definition": "Medium"
        },
        {
          "key": "H",
          "name": "High",
          "definition": "High"
        }
      ]
    }
  },
